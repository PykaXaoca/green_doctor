{
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "always",
        "source.organizeImports": "always"
    },
    "dart.flutterSdkPath": "",
    "dart.checkForSdkUpdates": false,
    "dart.openDevTools": "flutter",
    "files.exclude": {
        "**/.dart_tool": true,
        "**/build": true,
        "**/coverage": true,
        "**/ios/.symlinks": true,
        "**/windows": true,
        "**/linux": true,
        "**/macos": true,
        "**/web": true
    }
}